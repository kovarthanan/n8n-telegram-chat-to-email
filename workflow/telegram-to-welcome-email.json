    {
      "parameters": {
        "jsCode": "// Clean the LLM's reply into proper to / subject / body fields\nreturn $input.all().map(item => {\n  let raw = String(item.json.text || item.json.output || '').trim();\n\n  // Remove ```json ... ``` fences\n  raw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n\n  // If there's extra text around the JSON, keep only the {...} part\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start !== -1 && end !== -1) raw = raw.slice(start, end + 1);\n\n  try {\n    const data = JSON.parse(raw);\n    return {\n      json: {\n        to: (data.to || '').trim(),\n        subject: (data.subject || '').trim(),\n        body: (data.body || '').trim(),\n      },\n    };\n  } catch (e) {\n    return { json: { error: 'Could not parse LLM output', raw } };\n  }\n});"
      },
